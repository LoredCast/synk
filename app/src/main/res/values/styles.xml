<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Synk.Amoled" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/amoled_black</item>
        <item name="android:colorBackground">@color/amoled_black</item>
        <item name="android:statusBarColor">@color/amoled_black</item>
        <item name="android:navigationBarColor">@color/amoled_black</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorAccent">@color/accent_green</item>
        <item name="android:alertDialogTheme">@style/Theme.Synk.Amoled.Dialog</item>
    </style>

    <style name="Theme.Synk.Amoled.Dialog" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@color/amoled_surface</item>
        <item name="android:colorBackground">@color/amoled_surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorAccent">@color/accent_green</item>
    </style>
</resources>
